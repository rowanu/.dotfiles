# Machine-local identity and per-project overrides (gitignored, not tracked)
[include]
	path = ~/.gitconfig.local

[alias]
	# Staging and committing
	a = add
	ap = add -p
	ca = commit -a -m
	cm = commit -m
	wip = commit -am "wip"
	amend = commit --amend
	cane = commit --amend --no-edit
	fixup = commit --fixup
	undo = reset --soft HEAD~1
	unstage = restore --staged
	discard = restore

	# Branches
	b = branch
	ba = branch -a
	bd = branch -d
	bdd = branch -D
	co = checkout
	cob = checkout -b
	sw = switch
	swc = switch -c
	recent = branch --sort=-committerdate --format='%(committerdate:relative)%09%(refname:short)'

	# Rebasing and cherry-picking
	ri = rebase -i
	rc = rebase --continue
	ra = rebase --abort
	cp = cherry-pick

	# Syncing
	f = fetch
	p = push
	pf = push --force-with-lease
	pl = pull

	# Stashing
	ss = stash
	sa = stash apply
	sl = stash list
	sp = stash pop

	# Inspecting
	st = status
	d = diff
	dc = diff --cached
	ds = diff --stat
	dw = diff --ignore-space-change
	conflicts = diff --name-only --diff-filter=U
	hist = log --pretty=format:\"%C(yellow)%h%Cblue%d%Creset %s %C(green) %an, %ar%Creset\" --graph --date=short
	l = hist
	last = log -1 --stat
	# Search all history for a string: git pick 'someString'
	pick = log --all --source -S
	bl = blame -w -CCC
	who = shortlog -sn --no-merges

	# Meta
	aliases = config --get-regexp ^alias\\.
	root = rev-parse --show-toplevel

[color]
	branch = auto
	diff = auto
	interactive = auto
	status = auto

[push]
	default = simple
	autoSetupRemote = true

[pull]
	rebase = true

[rebase]
	autosquash = true
	autostash = true

[diff]
	algorithm = histogram
	colorMoved = zebra

[merge]
	conflictstyle = zdiff3

# Remember conflict resolutions and replay them on later rebases
[rerere]
	enabled = true

[init]
	defaultBranch = main

[gpg]
	format = ssh

[core]
	excludesfile = ~/.gitignore
